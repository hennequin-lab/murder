#!/bin/sh
# Thin wrapper around the commands we run every day.
set -eu

usage() {
  cat <<'EOF'
Usage: ./dev <command> [args]

  setup     install hooks, generate the dev opam file, build .cmt
  fmt       apply formatting (dune fmt)
  check     dune build @ci, then the full litany roster
  test      dune runtest
  lint      dune exec -- litany check
  lock      dune pkg lock plus the Raven-main lock patch
  outdated  dune pkg outdated
  new       scaffold packages/<name>
  wt        create, list, and remove worktrees (./dev wt help)
EOF
}

cmd=${1:-help}
[ "$#" -gt 0 ] && shift || true

case "$cmd" in
  setup)
    command -v dune >/dev/null 2>&1 || {
      echo "dune is required (3.24.2 or newer)" >&2
      exit 1
    }
    git config core.hooksPath .githooks
    dune build @check
    # opam/murder-dev.opam is generated and gitignored, so a fresh clone or
    # worktree has no copy and @ci fails until it exists. Dune reports the
    # promotion as a failed rule the first time; the retry confirms it.
    dune build @install --auto-promote || dune build @install --auto-promote
    echo "Ready. Try: dune exec getting-started/01-nx/ex01_arrays.exe"
    ;;
  fmt) dune fmt ;;
  check)
    dune build @ci
    dune exec -- litany check
    ;;
  test) dune runtest ;;
  lint) dune exec -- litany check ;;
  lock) exec scripts/relock.sh ;;
  outdated) dune pkg outdated ;;
  new)
    name=${1:?usage: ./dev new PACKAGE}
    exec scripts/new-package.sh "$name"
    ;;
  wt) exec scripts/worktree.sh "$@" ;;
  help | *) usage ;;
esac
