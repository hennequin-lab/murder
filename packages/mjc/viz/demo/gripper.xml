<mujoco model="gripper">
  <!-- A tendon-driven gripper: two mirrored fingers, each two links, each
       pulled by one fixed tendon over its own two joints. One motor per
       tendon, and the two motors get the same control, so the fingers close
       and open together. The joint springs open the hand when the tendon
       force reverses.

       Nothing here touches anything else, which is the point: every motion in
       this demo comes from the tendon, the actuator behind it, and the joint
       springs that open the hand again. -->
  <option timestep="0.002" integrator="implicitfast" gravity="0 0 -9.81"/>
  <worldbody>
    <body name="palm" pos="0 0 1.0">
      <geom name="g_palm" contype="0" conaffinity="0" type="box" size="0.055 0.075 0.02" rgba="0.30 0.34 0.40 1"/>
      <!-- Left finger: hinges about -y, so a positive joint angle closes it. -->
      <body name="fl1" pos="-0.045 0 -0.02">
        <joint name="fl1j" type="hinge" axis="0 -1 0" stiffness="0.55" damping="0.02"
               range="-1.1 0.02" limited="true"/>
        <geom name="g_fl1" contype="0" conaffinity="0" type="box" size="0.012 0.012 0.075" pos="0 0 -0.075"
              rgba="0.85 0.35 0.25 1"/>
        <body name="fl2" pos="0 0 -0.15">
          <joint name="fl2j" type="hinge" axis="0 -1 0" stiffness="0.35" damping="0.02"
                 range="-1.2 0.02" limited="true"/>
          <geom name="g_fl2" contype="0" conaffinity="0" type="box" size="0.010 0.010 0.055" pos="0 0 -0.055"
                rgba="0.92 0.55 0.35 1"/>
          <site name="sl" pos="0 0 -0.11"/>
        </body>
      </body>
      <!-- Right finger: the mirror, hinges about +y. -->
      <body name="fr1" pos="0.045 0 -0.02">
        <joint name="fr1j" type="hinge" axis="0 1 0" stiffness="0.55" damping="0.02"
               range="-0.02 1.1" limited="true"/>
        <geom name="g_fr1" contype="0" conaffinity="0" type="box" size="0.012 0.012 0.075" pos="0 0 -0.075"
              rgba="0.25 0.45 0.85 1"/>
        <body name="fr2" pos="0 0 -0.15">
          <joint name="fr2j" type="hinge" axis="0 1 0" stiffness="0.35" damping="0.02"
                 range="-0.02 1.2" limited="true"/>
          <geom name="g_fr2" contype="0" conaffinity="0" type="box" size="0.010 0.010 0.055" pos="0 0 -0.055"
                rgba="0.35 0.65 0.95 1"/>
          <site name="sr" pos="0 0 -0.11"/>
        </body>
      </body>
    </body>
  </worldbody>
  <tendon>
    <fixed name="t_left">
      <joint joint="fl1j" coef="1"/>
      <joint joint="fl2j" coef="1"/>
    </fixed>
    <fixed name="t_right">
      <joint joint="fr1j" coef="1"/>
      <joint joint="fr2j" coef="1"/>
    </fixed>
  </tendon>
  <actuator>
    <motor name="a_left" tendon="t_left" gear="1" ctrlrange="-4 4"/>
    <motor name="a_right" tendon="t_right" gear="1" ctrlrange="-4 4"/>
  </actuator>
  <sensor>
    <tendonpos tendon="t_left"/>
    <tendonvel tendon="t_left"/>
    <jointpos joint="fl1j"/>
    <actuatorfrc actuator="a_left"/>
    <subtreecom body="fl1"/>
  </sensor>
</mujoco>
