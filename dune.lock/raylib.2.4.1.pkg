(version 2.4.1)

(build
 (all_platforms
  ((action
    (progn
     (when %{pkg-self:dev} (run dune subst))
     (run
      env
      (when false "")
      dune
      build
      -p
      %{pkg-self:name}
      -j
      %{jobs}
      @install))))))

(depends
 (choice
  ((((arch x86_64)
     (os linux))
    ((arch arm64)
     (os linux)))
   (dune
    ocaml
    dune-configurator
    ctypes
    integers
    patch
    conf-mesa
    conf-libxcursor
    conf-libxi
    conf-libxinerama
    conf-libxrandr))
  ((((arch x86_64)
     (os macos))
    ((arch arm64)
     (os macos)))
   (dune ocaml dune-configurator ctypes integers patch))))

(source
 (fetch
  (url
   https://github.com/tjammer/raylib-ocaml/releases/download/2.4.1/raylib-2.4.1.tbz)
  (checksum
   sha512=45bd1e529bf63a12e6aea7f0d3f36b642decf28502379d8205dc2928c0fbd76a5f295be2e365c9887ef550d9b66d8aa195cc0a402932e28711f0d1cd994ba1df)))
