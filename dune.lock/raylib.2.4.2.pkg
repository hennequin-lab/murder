(version 2.4.2)

(build
 (all_platforms
  ((action
    (progn
     (when %{pkg-self:dev} (run dune subst))
     (run
      env
      (when false "")
      dune
      build
      -p
      %{pkg-self:name}
      -j
      %{jobs}
      @install))))))

(depends
 (choice
  ((((arch x86_64)
     (os linux))
    ((arch arm64)
     (os linux)))
   (dune
    ocaml
    dune-configurator
    ctypes
    integers
    patch
    conf-mesa
    conf-libxcursor
    conf-libxi
    conf-libxinerama
    conf-libxrandr))
  ((((arch x86_64)
     (os macos))
    ((arch arm64)
     (os macos)))
   (dune ocaml dune-configurator ctypes integers patch))))

(source
 (fetch
  (url
   https://github.com/tjammer/raylib-ocaml/releases/download/2.4.2/raylib-2.4.2.tbz)
  (checksum
   sha512=b74ca2f8e9d9a2fc13bc860590b7fbcf30100295a9fb6006b25c80a343df8cec890700cc0fb084a063f8833400415283236666cdf06f44ab2e872c7b7e9d9485)))
