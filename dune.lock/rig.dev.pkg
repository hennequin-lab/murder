(version dev)

(build
 (all_platforms ((dune))))

(depends
 (choice
  ((((arch x86_64)
     (os linux))
    ((arch arm64)
     (os linux)))
   (ocaml dune conf-linux-libc-dev))
  ((((arch x86_64)
     (os macos))
    ((arch arm64)
     (os macos)))
   (ocaml dune))))

(source
 (fetch
  (url
   git+https://github.com/raven-ml/raven.git#c17412beda27fb9292ac1695b861950501406788)))

(dev)
